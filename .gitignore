# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
.next/
out/
dist/
build/
*.tsbuildinfo

# Environment — never commit real values.
# Deny every .env* variant, then allow back only the documented templates.
# The previous explicit list (.env, .env.local, .env.production) missed
# anything else — .env.deploy, .env.staging, .env.backup all slipped through.
.env*
!.env.example
!.env*.example

# Agent artifact scratch space (ephemeral by design)
orqis-backend/storage/r/*
orqis-owned-services/storage/r/*
!**/storage/r/.gitkeep

# Large runtime caches
**/eng.traineddata
**/.playwright/

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*
logs/

# Vercel / Next
.vercel

# Python sidecars
__pycache__/
*.py[cod]
.venv/
venv/

# Claude Code local settings (contain machine-specific absolute paths)
.claude/

# Crash artifacts
*.stackdump
