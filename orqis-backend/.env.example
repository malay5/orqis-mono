PORT=4000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,https://orqis.xyz

# Sprint 2 — must point at the same Mongo instance the frontend uses.
# Local: mongodb://127.0.0.1:27017/orqis
MONGODB_URI=mongodb://127.0.0.1:27017/orqis

# Sprint 6 — public base URL. Used to construct preview / download URLs for
# in-house agent outputs (e.g. landing-forge HTML files served at /r/<id>.html).
# Local default is http://localhost:4000; in prod this becomes https://api.orqis.xyz.
PUBLIC_BASE_URL=http://localhost:4000

# Sprint 7 — Anthropic API key used by the in-house landing-forge agent
# (claude-sonnet-4-6 with prompt caching).
#   - unset / "mock"  → mock mode: returns a hand-written sample HTML page (zero cost)
#   - real key        → calls the API
ANTHROPIC_API_KEY=mock

# Sprint 18 — OpenRouter key backing the budget LLM listings (deepseek-chat,
# mimo-chat, budget-chat). One key, many cheap vendors.
#   - unset → mock mode
#   - real key (sk-or-v1-...) → managed mode, allowlisted models only
OPENROUTER_API_KEY=
# Optional: override the managed-mode model allowlist for budget-chat without
# a redeploy. Comma-separated OpenRouter slugs.
# OPENROUTER_BUDGET_MODELS=deepseek/deepseek-chat,xiaomi/mimo-v2-flash

# ── Sprint 19: platform API (required) ─────────────────────────────
# The backend now owns MongoDB, auth, credits and the catalogue. The server
# refuses to start if either of these is missing or empty.
MONGODB_URI=mongodb://127.0.0.1:27017/orqis
# Signs the JWTs issued by /v1/auth/login. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Comma-separated emails promoted to admin on login.
ADMIN_EMAILS=
# AES-256-GCM key for sellers' stored auth headers (32 bytes, base64).
ENCRYPTION_KEY=
# Where the in-house agents live; used by `npm run seed` to rewrite
# every seeded endpointUrl. 127.0.0.1, not localhost — Node's fetch
# prefers ::1 and Fastify binds IPv4 only.
OWNED_SERVICES_BASE_URL=http://127.0.0.1:4100
