# ---------- Home page mode ----------
# "waitlist" (default) → Sprint-1 launch landing with Join-waitlist + List-your-agent CTAs.
# "default"            → public marketplace landing (browse + featured agents + sign-in).
# Read server-side; a restart of `npm run dev` is required after changing.
HOME_MODE=waitlist

# ---------- Sprint 1: Apps Script intake ----------
# Google Apps Script Web App URL — see ../apps-script-setup/README.md
# https://script.google.com/macros/s/AKfyc.../exec
APPS_SCRIPT_URL=

# ---------- Sprint 2: MongoDB ----------
# Local dev:        mongodb://127.0.0.1:27017/orqis
# Mongo Atlas:      mongodb+srv://<user>:<pw>@<cluster>/orqis?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/orqis

# ---------- Sprint 2: NextAuth (Auth.js v5) ----------
# Generate with: openssl rand -base64 32   (or: npx auth secret)
AUTH_SECRET=

# Google OAuth client (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI:  http://localhost:3000/api/auth/callback/google
# Add your prod URI too when you deploy:  https://orqis.xyz/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Set in production (Vercel) — optional locally.
# AUTH_URL=https://orqis.xyz

# ---------- Sprint 4: admin allowlist ----------
# Comma-separated list of emails that get role=admin on sign-in.
# Admins can access /admin (gated; non-admins get a 404), grant credits to any user,
# and approve/reject pending agent submissions.
# Example: ADMIN_EMAILS=you@gmail.com,cofounder@gmail.com
ADMIN_EMAILS=

# ---------- Sprint 5: secret encryption ----------
# Used by lib/crypto-server.ts (AES-256-GCM) to encrypt seller-supplied auth
# headers at rest in the agents collection. Any string of length >= 16; we hash
# it with SHA-256 to derive the actual key.
# Generate with: openssl rand -base64 32
# DO NOT change after sellers have submitted agents — existing ciphertexts will
# stop decrypting. Treat this like a database password.
ENCRYPTION_KEY=

# ---------- Sprint 16+: owned-services agent host ----------
# Base URL of the orqis-owned-services deployment that hosts the in-house
# agent endpoints. Seed catalogue URLs hardcoded http://localhost:4000 (the
# orqis-backend dev port); resolveSeedEndpoint() swaps the host prefix when
# writing to Mongo via `npm run seed` and when rendering the seed-fallback.
#   Local dev (default):     http://localhost:4100
#   If you're running orqis-backend locally instead:  http://localhost:4000
#   Production:              https://owned-services.orqis.xyz
OWNED_SERVICES_BASE_URL=http://localhost:4100

# ── Sprint 19/20: the frontend is a thin client of orqis-backend ───
# It has no database and no auth framework. MONGODB_URI, ENCRYPTION_KEY,
# ADMIN_EMAILS and AUTH_SECRET all live in orqis-backend/.env now — the
# backend verifies passwords and signs the tokens; this app only stores
# the token it is handed, in an httpOnly cookie.
#
# REQUIRED in any deployed environment — the frontend has no database and
# reads everything from the backend. If it is missing, requests fall back to
# loopback and fail with "connect ECONNREFUSED 127.0.0.1:4000", which looks
# like the backend is down rather than unconfigured.
#
#   local dev  : http://127.0.0.1:4000   (127.0.0.1, not localhost — Node's
#                fetch prefers ::1 and Fastify binds IPv4)
#   deployed   : https://your-backend-host
ORQIS_API_URL=http://127.0.0.1:4000

# Canonical origin. Drives metadataBase, the sitemap, robots.txt and every
# canonical/OG URL — set it to the real domain before deploying or every
# canonical tag will point at orqis.xyz.
NEXT_PUBLIC_SITE_URL=https://orqis.xyz
