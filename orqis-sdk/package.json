{
  "name": "@orqis/sdk",
  "version": "0.1.0",
  "description": "Official JS/TS client for the orqis marketplace API.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "tsx examples/sdk-smoke-test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "orqis",
    "ai",
    "agents",
    "marketplace",
    "claude",
    "mcp"
  ],
  "homepage": "https://orqis.xyz",
  "repository": {
    "type": "git",
    "url": "https://github.com/malay5/orqis-sdk.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2"
  }
}
